[global]
    monitor = 0
    follow = mouse

    width = 360
    height = 120
    origin = top-right
    offset = 12x12

    scale = 0

    notification_limit = 5

    frame_width = 1
    frame_color = "#89b4fa"

    separator_height = 2
    separator_color = frame

    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8

    corner_radius = 12

    font = JetBrainsMono Nerd Font 10

    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    show_age_threshold = 60
    ellipsize = middle

    stack_duplicates = true
    hide_duplicate_count = true

    icon_position = left
    min_icon_size = 32
    max_icon_size = 32

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

    idle_threshold = 120

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#45475a"
    timeout = 2

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 3

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 4
