# Config generated by Ghostty Config

term = "xterm-256color"
theme = iTerm2 Solarized Dark
background = 111111
# background-opacity = 0.85
#background-blur = false
maximize = true
# fullscreen = true
confirm-close-surface=false
font-size = 22
font-family = Hack Nerd Font Mono
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

shell-integration-features = no-cursor,no-sudo,no-title
gtk-titlebar = false
