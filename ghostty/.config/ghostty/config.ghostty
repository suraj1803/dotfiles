# Config generated by Ghostty Config

term = "xterm-256color"
theme = TokyoNight

# theme = iTerm2 Solarized Dark
# background = 000000
# background-opacity = 0.8
maximize = true
# fullscreen = true
confirm-close-surface=false
font-size = 18
font-family = Hack Nerd Font Mono
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

shell-integration-features = no-cursor,no-sudo,no-title
gtk-titlebar = false
