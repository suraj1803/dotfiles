# Config generated by Ghostty Config

term = "xterm-256color"
theme = Kitty Default
background = 000000
# background-opacity = 0.8
#background-blur = false
maximize = true
# fullscreen = true
confirm-close-surface=false
font-size = 20
font-family = Hack Nerd Font Mono
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

shell-integration-features = no-cursor,no-sudo,no-title
gtk-titlebar = false
